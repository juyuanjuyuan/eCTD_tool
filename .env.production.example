# ============================================================
# eCTD Tool - Production Environment Variables
# Copy this file to .env.production and fill in the values
# ============================================================

# ---- PostgreSQL ----
POSTGRES_DB=ectd
POSTGRES_USER=ectd
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ---- Database Connection Pool ----
DB_CONNECTION_LIMIT=20
DB_POOL_TIMEOUT=30

# ---- JWT Authentication ----
JWT_SECRET=CHANGE_ME_RANDOM_64_CHAR_STRING
JWT_EXPIRES_IN=2h
JWT_REFRESH_SECRET=CHANGE_ME_ANOTHER_RANDOM_64_CHAR_STRING
JWT_REFRESH_EXPIRES_IN=7d

# ---- Redis ----
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_MAXMEMORY=256mb

# ---- MinIO (S3-compatible storage) ----
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET
MINIO_BUCKET=ectd-files

# ---- Application ----
APP_PORT=80
APP_HTTPS_PORT=443
NODE_ENV=production
CORS_ORIGINS=https://your-domain.com

# ---- SSL/TLS (optional, for HTTPS) ----
# Place cert files in ./ssl/ directory
# SSL_CERT_PATH=./ssl/cert.pem
# SSL_KEY_PATH=./ssl/key.pem

# ---- Logging ----
LOG_LEVEL=warn

# ---- Swagger API Docs ----
# Set to 'true' to enable Swagger in production
# ENABLE_SWAGGER=false

# ---- Database Backup ----
# Backup retention in days
BACKUP_RETENTION_DAYS=30
BACKUP_DIR=/backups
