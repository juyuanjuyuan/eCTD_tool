generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== Enums ====================

enum Role {
  ADMIN
  MANAGER
  EDITOR
  VIEWER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProjectMemberRole {
  OWNER
  MEMBER
  VIEWER
}

enum SequenceStatus {
  DRAFT
  EDITING
  VALIDATING
  EXPORTED
  SUBMITTED
}

enum CtdNodeType {
  MODULE
  SECTION
  LEAF
  EXTENSION_POINT
}

enum SequenceNodeStatus {
  EMPTY
  EDITING
  COMPLETED
}

enum LeafOperation {
  NEW
  REPLACE
  APPEND
  DELETE
}

enum ApprovalStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum CompletenessRuleSeverity {
  ERROR
  WARNING
}

enum CompletenessRuleType {
  REQUIRED // 必须包含
  FORBIDDEN // 不能包含
}

enum ValidationSeverity {
  ERROR
  WARNING
  INFO
}

enum ComplianceStatus {
  PASS
  WARNING
  ERROR
}

// ==================== User ====================

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String     @map("password_hash")
  name         String     @db.VarChar(100)
  phone        String?    @db.VarChar(20)
  role         Role       @default(EDITOR)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  projectMembers  ProjectMember[]
  createdProjects Project[]       @relation("ProjectCreator")
  comments        Comment[]
  activityLogs    ActivityLog[]

  @@map("user")
}

// ==================== Project ====================

model Project {
  id          String        @id @default(uuid())
  name        String        @db.VarChar(200)
  description String?       @db.Text
  status      ProjectStatus @default(DRAFT)
  createdBy   String        @map("created_by")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  creator      User            @relation("ProjectCreator", fields: [createdBy], references: [id])
  members      ProjectMember[]
  applications Application[]

  @@map("project")
}

model ProjectMember {
  id        String            @id @default(uuid())
  projectId String            @map("project_id")
  userId    String            @map("user_id")
  role      ProjectMemberRole @default(MEMBER)
  createdAt DateTime          @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_member")
}

// ==================== Application (envelope - application level) ====================

model Application {
  id                     String   @id @default(uuid())
  projectId              String   @map("project_id")
  applicationNumber      String   @unique @map("application_number") @db.VarChar(15)
  applicationTypeCode    String   @map("application_type_code") @db.VarChar(10)
  applicationTypeVersion String   @map("application_type_version") @db.VarChar(10)
  productTypeCode        String   @map("product_type_code") @db.VarChar(10)
  productTypeVersion     String   @map("product_type_version") @db.VarChar(10)
  productNumber          String   @map("product_number") @db.VarChar(10)
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  project              Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  regulatoryActivities RegulatoryActivity[]

  @@index([projectId])
  @@map("application")
}

// ==================== Regulatory Activity (envelope - RA level) ====================

model RegulatoryActivity {
  id                            String   @id @default(uuid())
  applicationId                 String   @map("application_id")
  regulatoryActivityTypeCode    String   @map("regulatory_activity_type_code") @db.VarChar(10)
  regulatoryActivityTypeVersion String   @map("regulatory_activity_type_version") @db.VarChar(10)
  relatedSequence               String   @map("related_sequence") @db.Char(4)
  createdAt                     DateTime @default(now()) @map("created_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  sequences   Sequence[]

  @@index([applicationId])
  @@map("regulatory_activity")
}

// ==================== Sequence (envelope - sequence level) ====================

model Sequence {
  id                   String         @id @default(uuid())
  regulatoryActivityId String         @map("regulatory_activity_id")
  sequenceNumber       String         @map("sequence_number") @db.Char(4)
  sequenceTypeCode     String         @map("sequence_type_code") @db.VarChar(10)
  sequenceTypeVersion  String         @map("sequence_type_version") @db.VarChar(10)
  description          String         @db.VarChar(500)
  contactName          String         @map("contact_name") @db.VarChar(100)
  contactPhone         String         @map("contact_phone") @db.VarChar(20)
  contactEmail         String         @map("contact_email") @db.VarChar(255)
  status               SequenceStatus @default(DRAFT)
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  regulatoryActivity RegulatoryActivity @relation(fields: [regulatoryActivityId], references: [id], onDelete: Cascade)
  sequenceNodes      SequenceNode[]
  validationReports  ValidationReport[]

  @@unique([regulatoryActivityId, sequenceNumber])
  @@index([regulatoryActivityId])
  @@map("sequence")
}

// ==================== CTD Template Node (法规定义的目录模板) ====================

model CtdTemplateNode {
  id               String      @id @default(uuid())
  parentId         String?     @map("parent_id")
  module           Int         @db.SmallInt // 1-5
  elementName      String      @unique @map("element_name") @db.VarChar(120)
  ctdSectionNumber String      @map("ctd_section_number") @db.VarChar(20)
  titleZh          String      @map("title_zh") @db.VarChar(500)
  titleEn          String      @map("title_en") @db.VarChar(500)
  nodeType         CtdNodeType @map("node_type")
  isLeaf           Boolean     @default(false) @map("is_leaf")
  requiresStf      Boolean     @default(false) @map("requires_stf")
  requiresESeal    Boolean     @default(false) @map("requires_e_seal")
  allowsExtension  Boolean     @default(false) @map("allows_extension")
  sortOrder        Int         @map("sort_order")

  parent            CtdTemplateNode?      @relation("CtdTemplateTree", fields: [parentId], references: [id])
  children          CtdTemplateNode[]     @relation("CtdTemplateTree")
  completenessRules CtdCompletenessRule[]
  sequenceNodes     SequenceNode[]

  @@index([parentId])
  @@index([module])
  @@map("ctd_template_node")
}

// ==================== CTD Completeness Rule (4.3.x 内容完整性规则) ====================

model CtdCompletenessRule {
  id                         String                   @id @default(uuid())
  applicationTypeCode        String                   @map("application_type_code") @db.VarChar(10)
  regulatoryActivityTypeCode String                   @map("regulatory_activity_type_code") @db.VarChar(10)
  templateNodeId             String                   @map("template_node_id")
  ruleType                   CompletenessRuleType     @default(REQUIRED) @map("rule_type")
  severity                   CompletenessRuleSeverity @default(ERROR)

  templateNode CtdTemplateNode @relation(fields: [templateNodeId], references: [id], onDelete: Cascade)

  @@index([applicationTypeCode, regulatoryActivityTypeCode])
  @@map("ctd_completeness_rule")
}

// ==================== Sequence Node (序列目录实例) ====================

model SequenceNode {
  id               String             @id @default(uuid())
  sequenceId       String             @map("sequence_id")
  templateNodeId   String             @map("template_node_id")
  parentId         String?            @map("parent_id")
  elementName      String             @map("element_name") @db.VarChar(120)
  ctdSectionNumber String             @map("ctd_section_number") @db.VarChar(20)
  title            String             @db.VarChar(500)
  operation        LeafOperation?
  status           SequenceNodeStatus @default(EMPTY)
  isRequired       Boolean            @default(false) @map("is_required")
  isLeaf           Boolean            @default(false) @map("is_leaf")
  sortOrder        Int                @map("sort_order")
  // Backbone attributes (only for specific nodes)
  substance        String?            @db.VarChar(200)
  manufacturer     String?            @db.VarChar(200)
  productName      String?            @map("product_name") @db.VarChar(200)
  dosageForm       String?            @map("dosage_form") @db.VarChar(200)
  indication       String?            @db.VarChar(500)
  // Approval fields
  approvalStatus   ApprovalStatus     @default(DRAFT) @map("approval_status")
  submittedBy      String?            @map("submitted_by")
  submittedAt      DateTime?          @map("submitted_at")
  approvedBy       String?            @map("approved_by")
  approvedAt       DateTime?          @map("approved_at")
  rejectionReason  String?            @map("rejection_reason") @db.Text

  sequence         Sequence          @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  templateNode     CtdTemplateNode   @relation(fields: [templateNodeId], references: [id])
  parent           SequenceNode?     @relation("SequenceNodeTree", fields: [parentId], references: [id])
  children         SequenceNode[]    @relation("SequenceNodeTree")
  document         Document?
  fileAttachments  FileAttachment[]
  studyTaggingFile StudyTaggingFile?
  comments         Comment[]

  @@index([sequenceId])
  @@index([templateNodeId])
  @@index([parentId])
  @@map("sequence_node")
}

// ==================== Document (章节文档内容) ====================

model Document {
  id          String   @id @default(uuid())
  nodeId      String   @unique @map("node_id")
  contentJson Json?    @map("content_json")
  contentHtml String?  @map("content_html") @db.Text
  contentText String?  @map("content_text") @db.Text
  wordCount   Int      @default(0) @map("word_count")
  version     Int      @default(1)
  xmlLang     String   @default("zh") @map("xml_lang") @db.VarChar(10)
  createdBy   String?  @map("created_by")
  updatedBy   String?  @map("updated_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  node     SequenceNode      @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  versions DocumentVersion[]

  @@index([nodeId])
  @@map("document")
}

// ==================== Document Version (文档历史版本快照) ====================

model DocumentVersion {
  id          String   @id @default(uuid())
  documentId  String   @map("document_id")
  version     Int
  contentJson Json?    @map("content_json")
  contentHtml String?  @map("content_html") @db.Text
  wordCount   Int      @default(0) @map("word_count")
  xmlLang     String   @default("zh") @map("xml_lang") @db.VarChar(10)
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([documentId, version])
  @@map("document_version")
}

// ==================== Controlled Vocabulary ====================

model ControlledVocabulary {
  id             String    @id @default(uuid())
  vocabularyName String    @map("vocabulary_name") @db.VarChar(50)
  code           String    @db.VarChar(10)
  version        String    @db.VarChar(10)
  validFrom      DateTime  @map("valid_from") @db.Date
  validTo        DateTime? @map("valid_to") @db.Date
  descriptionZh  String    @map("description_zh") @db.VarChar(200)
  descriptionEn  String    @map("description_en") @db.VarChar(200)

  @@unique([vocabularyName, code, version])
  @@index([vocabularyName, code])
  @@map("controlled_vocabulary")
}

// ==================== CV Dependency (application-type -> RA-type -> sequence-type) ====================

model CvDependency {
  id                         String  @id @default(uuid())
  applicationTypeCode        String  @map("application_type_code") @db.VarChar(10)
  regulatoryActivityTypeCode String  @map("regulatory_activity_type_code") @db.VarChar(10)
  sequenceTypeCode           String? @map("sequence_type_code") @db.VarChar(10)
  version                    String  @db.VarChar(10)

  @@index([applicationTypeCode, regulatoryActivityTypeCode])
  @@map("cv_dependency")
}

// ==================== File Attachment (上传的文件) ====================

model FileAttachment {
  id               String   @id @default(uuid())
  sequenceNodeId   String   @map("sequence_node_id")
  originalName     String   @map("original_name") @db.VarChar(255)
  storedName       String   @map("stored_name") @db.VarChar(255)
  storagePath      String   @map("storage_path") @db.VarChar(500)
  ectdRelativePath String   @map("ectd_relative_path") @db.VarChar(180)
  fileType         String   @map("file_type") @db.VarChar(10)
  fileSize         BigInt   @map("file_size")
  md5Checksum      String   @map("md5_checksum") @db.Char(32)
  xmlLang          String   @default("zh") @map("xml_lang") @db.VarChar(10)
  isReference      Boolean  @default(false) @map("is_reference")
  referenceFileId  String?  @map("reference_file_id")
  uploadedBy       String?  @map("uploaded_by")
  createdAt        DateTime @default(now()) @map("created_at")

  sequenceNode  SequenceNode     @relation(fields: [sequenceNodeId], references: [id], onDelete: Cascade)
  referenceFile FileAttachment?  @relation("FileReference", fields: [referenceFileId], references: [id])
  referencedBy  FileAttachment[] @relation("FileReference")
  pdfAnalysis   FilePdfAnalysis?

  @@index([sequenceNodeId])
  @@map("file_attachment")
}

// ==================== File PDF Analysis (PDF 合规分析) ====================

model FilePdfAnalysis {
  id                  String           @id @default(uuid())
  fileAttachmentId    String           @unique @map("file_attachment_id")
  pdfVersion          String?          @map("pdf_version") @db.VarChar(10)
  pageCount           Int              @default(0) @map("page_count")
  hasBookmarks        Boolean          @default(false) @map("has_bookmarks")
  bookmarkZoomInherit Boolean          @default(false) @map("bookmark_zoom_inherit")
  isEncrypted         Boolean          @default(false) @map("is_encrypted")
  hasJavascript       Boolean          @default(false) @map("has_javascript")
  hasExternalLinks    Boolean          @default(false) @map("has_external_links")
  hasAttachments      Boolean          @default(false) @map("has_attachments")
  hasMultimedia       Boolean          @default(false) @map("has_multimedia")
  isTextSearchable    Boolean          @default(true) @map("is_text_searchable")
  fontsEmbedded       Boolean          @default(true) @map("fonts_embedded")
  hasESeal            Boolean          @default(false) @map("has_e_seal")
  complianceStatus    ComplianceStatus @default(PASS) @map("compliance_status")
  complianceDetails   Json?            @map("compliance_details")
  analyzedAt          DateTime         @default(now()) @map("analyzed_at")

  fileAttachment FileAttachment @relation(fields: [fileAttachmentId], references: [id], onDelete: Cascade)

  @@map("file_pdf_analysis")
}

// ==================== Study Tagging File (STF 研究标签文件) ====================

model StudyTaggingFile {
  id             String        @id @default(uuid())
  sequenceNodeId String        @unique @map("sequence_node_id")
  studyTitle     String        @map("study_title") @db.VarChar(500)
  studyId        String        @map("study_id") @db.VarChar(100)
  categories     Json? // {species, routeOfAdmin, duration, typeOfControl}
  fileTags       Json?         @map("file_tags") // [{name, infoType}]
  stfXmlContent  String?       @map("stf_xml_content") @db.Text
  operation      LeafOperation @default(NEW)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  sequenceNode SequenceNode @relation(fields: [sequenceNodeId], references: [id], onDelete: Cascade)

  @@map("study_tagging_file")
}

// ==================== Validation Report ====================

model ValidationReport {
  id            String   @id @default(uuid())
  sequenceId    String   @map("sequence_id")
  totalErrors   Int      @default(0) @map("total_errors")
  totalWarnings Int      @default(0) @map("total_warnings")
  totalInfos    Int      @default(0) @map("total_infos")
  isPassed      Boolean  @default(false) @map("is_passed")
  createdAt     DateTime @default(now()) @map("created_at")

  sequence Sequence         @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  items    ValidationItem[]

  @@index([sequenceId])
  @@map("validation_report")
}

// ==================== Validation Item ====================

model ValidationItem {
  id           String             @id @default(uuid())
  reportId     String             @map("report_id")
  ruleCode     String             @map("rule_code") @db.VarChar(10)
  ruleCategory String             @map("rule_category") @db.VarChar(50)
  severity     ValidationSeverity
  description  String             @db.Text
  detail       String?            @db.Text
  filePath     String?            @map("file_path") @db.VarChar(500)
  suggestion   String?            @db.Text

  report ValidationReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([reportId, severity])
  @@map("validation_item")
}

// ==================== Comment (节点评论) ====================

model Comment {
  id             String   @id @default(uuid())
  sequenceNodeId String   @map("sequence_node_id")
  userId         String   @map("user_id")
  content        String   @db.Text
  mentions       Json?    @default("[]")
  parentId       String?  @map("parent_id")
  createdAt      DateTime @default(now()) @map("created_at")

  sequenceNode SequenceNode @relation(fields: [sequenceNodeId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent       Comment?     @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies      Comment[]    @relation("CommentReplies")

  @@index([sequenceNodeId, createdAt])
  @@map("comment")
}

// ==================== Activity Log (操作日志) ====================

model ActivityLog {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  action     String   @db.VarChar(50)
  resource   String   @db.VarChar(50)
  resourceId String   @map("resource_id")
  detail     Json?
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([resource, resourceId])
  @@index([userId])
  @@index([createdAt])
  @@map("activity_log")
}
